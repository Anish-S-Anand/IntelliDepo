# ===========================================
# Intelli Platform — Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# App
PROJECT_NAME=Intelli Platform
VERSION=0.1.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://intelli:intelli@localhost:5432/intelli
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# MFA
MFA_ISSUER_NAME=Intelli Platform

# OAuth2
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# API Keys
API_KEY_PREFIX=intelli_

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=60

# Sessions
SESSION_MAX_AGE_SECONDS=604800

# Encryption
ENCRYPTION_MASTER_KEY=
ENCRYPTION_FALLBACK_KEYS=
ENCRYPTION_KEY_VERSION=v1

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=intelli

# AI / LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector DB (Pinecone)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=intelli-default
VECTOR_DB_PROVIDER=memory
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_EMBEDDING_DIMENSION=384
VECTOR_DB_URL=

# Pinecone (for agent self-learning)
PINECONE_AGENT_INDEX=agent-outcomes

# Optional product modules
ENABLE_DEPOT_MODULES=false

# Agent Confidence & Fallback
CONFIDENCE_DEFAULT_THRESHOLD=0.7

# Celery (async task dispatch)
CELERY_BROKER_URL=

# Email / SMTP Configuration
# SMTP server hostname or IP address
SMTP_HOST=localhost
# SMTP server port (valid range: 0-65535, common: 25, 465, 587, 1025)
SMTP_PORT=1025
# SMTP authentication username (leave empty if no auth required)
SMTP_USER=
# SMTP authentication password (leave empty if no auth required)
SMTP_PASSWORD=
# Email address to use as sender for outgoing emails
SMTP_FROM_EMAIL=noreply@intelli.ai
# Email domain for generating Message-IDs
EMAIL_DOMAIN=intelli.ai
# Enable TLS encryption for SMTP connection (true/false)
SMTP_USE_TLS=false

# WhatsApp Notification Configuration
# WhatsApp provider: 'twilio', 'meta', or 'stub' (stub disables WhatsApp)
WHATSAPP_PROVIDER=stub
# WhatsApp API base URL (for Twilio or Meta Business API)
WHATSAPP_API_BASE_URL=https://api.twilio.com/2010-04-01/Accounts
# WhatsApp API authentication token (Twilio Auth Token or Meta Access Token)
WHATSAPP_API_TOKEN=
# WhatsApp sender phone number in E.164 format (e.g., +14155238886)
WHATSAPP_SENDER_NUMBER=

# Twilio-specific WhatsApp Configuration (if using WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta-specific WhatsApp Configuration (if using WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# General Notification Settings
NOTIFICATION_WEBHOOK_TIMEOUT=10
NOTIFICATION_WEBHOOK_RETRIES=3
NOTIFICATION_QUIET_HOURS_ENABLED=true
# Enable/disable notification channels independently (true/false)
NOTIFICATIONS_WHATSAPP_ENABLED=true
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_WEBSOCKET_ENABLED=true
