# ===========================================
# Intelli Platform — Environment Variables
# ===========================================

# App
DEBUG=false

# Database (PostgreSQL) — use "postgres" service name for Docker
DATABASE_URL=postgresql+asyncpg://intelli:intelli@postgres:5432/intelli

# Redis — use "redis" service name for Docker
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=change-me-to-a-random-string

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Storage (MinIO / S3) — use "minio" service name for Docker
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=intelli

# AI / LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector DB
VECTOR_DB_URL=

# Pinecone (for agent self-learning)
PINECONE_API_KEY=
PINECONE_INDEX=agent-outcomes

# Agent Confidence & Fallback
CONFIDENCE_DEFAULT_THRESHOLD=0.7

# Celery (async task dispatch)
CELERY_BROKER_URL=
